# ==============================================================================
# Stargate Delivery Management System - Environment Configuration
# ==============================================================================

# Core Application Security
SECRET_KEY=generate-a-random-64-byte-secret-outside-the-repository
PORT=5000
FLASK_ENV=production

# Database Configuration
# Default is local SQLite in data folder
DATABASE_PATH=data/stargate_production.db

# Administrative Initial Setup
# Initial credentials are generated once on first run and written to a mode-0600 local file.
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=
ADMIN_INITIAL_PIN=

# External Integrations
GEMINI_API_KEY=
GDRIVE_SERVICE_ACCOUNT_JSON=
GDRIVE_FOLDER_ID=

# Telegram Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
