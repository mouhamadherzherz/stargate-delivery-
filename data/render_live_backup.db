                                        <th class="py-2 px-2 text-center">المسجل</th>
                                        <th class="py-2 px-2 text-center">المسلّم</th>
                                        <th class="py-2 px-2 text-center">نسبة الإنجاز</th>
                                    </tr>
                                </thead>
                                <tbody id="agentsTableBody" class="divide-y divide-slate-50">
                                    <tr>
                                        <td colspan="5" class="py-6 text-center text-slate-400">جاري تحميل تقييم الموظفين...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- 3. Top Active Stores & AI Actionable Recommendations -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                    <!-- Top 5 Active Stores -->
                    <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
                        <div class="flex items-center gap-2 pb-3 mb-3 border-b border-slate-100">
                            <i class="fa-solid fa-store text-indigo-600"></i>
                            <h4 class="font-black text-slate-800 text-sm">أكثر المتاجر نشاطاً وتوليداً للشحنات</h4>
                        </div>
                        <div id="topMerchantsList" class="space-y-2.5">
                            <div class="py-4 text-center text-xs text-slate-400">جاري التحميل...</div>
                        </div>
                    </div>

                    <!-- AI Actionable Strategic Recommendations -->
                    <div class="bg-gradient-to-br from-indigo-900 to-slate-900 text-white p-5 rounded-2xl shadow-sm border border-indigo-800">
                        <div class="flex items-center gap-2 pb-3 mb-3 border-b border-indigo-700/50">
                            <i class="fa-solid fa-wand-magic-sparkles text-amber-300"></i>
                            <h4 class="font-black text-amber-300 text-sm">توصيات الذكاء الاصطناعي الذكية والمباشرة</h4>
                        </div>
                        <div id="aiRecommendationsList" class="space-y-2.5 text-xs text-indigo-100">
                            <div class="py-4 text-center text-indigo-300">جاري إعداد التوصيات...</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="bg-white border-t border-slate-200 p-4 px-6 flex items-center justify-between shrink-0">
                <span class="text-xs text-slate-500 font-medium">البيانات محدثة لحظياً وتتوافق مع الخزينة والمحاسبة 100%</span>
                <div class="flex items-center gap-2">
                    <button type="button" onclick="window.print()" class="px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition flex items-center gap-1.5">
                        <i class="fa-solid fa-print"></i>
                        <span>طباعة التقرير</span>
                    </button>
                    <button type="button" onclick="closeExecutiveReportModal()" class="px-5 py-2 rounded-xl bg-slate-900 hover:bg-black text-white text-xs font-black transition">
                        إغلاق النافذة
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

            </div>
        </main>
    </div>

    <!-- ADMIN UNLOCK PIN MODAL -->
    <div id="adminUnlockModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-3xl max-w-sm w-full p-6 shadow-2xl">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                <h3 class="text-base font-black text-slate-800 flex items-center gap-2">
                    <i class="fa-solid fa-shield-halved text-red-600"></i>
                    <span>تسجيل دخول المدير العام 👑</span>
                </h3>
                <button onclick="closeModal('adminUnlockModal')" class="text-slate-400 hover:text-slate-600 p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <form method="POST" action="/auth/unlock-admin" class="mt-4 space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">أدخل كلمة سر المدير:</label>
                    <input type="password" name="pin" required placeholder="••••••••" autofocus class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-lg font-black tracking-widest text-center focus:ring-2 focus:ring-red-500 font-mono">
                    <span class="text-[11px] text-slate-400 mt-1 block text-center">أدخل الرمز السري الخاص بالمدير للمتابعة</span>
                </div>

                <div class="pt-2 flex items-center justify-between gap-3 border-t border-slate-100">
                    <a href="/auth/recover-admin" class="text-[11px] text-slate-400 hover:text-red-600 transition">نسيت كلمة المرور؟</a>
                    <div class="flex gap-2">
                        <button type="button" onclick="closeModal('adminUnlockModal')" class="bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold px-4 py-2 rounded-xl text-xs transition">إلغاء</button>
                        <button type="submit" class="bg-red-600 hover:bg-red-700 text-white font-bold px-5 py-2 rounded-xl text-xs shadow-md shadow-red-600/20 transition">تأكيد الدخول</button>
                    </div>
                </div>
            </form>
        </div>
    </div>


    <!-- Scripts -->
    <script>
        function openModal(id) {
            const el = document.getElementById(id);
            if (el) el.classList.remove('hidden');
        }
        function closeModal(id) {
            const el = document.getElementById(id);
            if (el) el.classList.add('hidden');
        }

        const sidebar = document.getElementById('sidebar');
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const closeSidebarBtn = document.getElementById('closeSidebarBtn');
        const mobileOverlay = document.getElementById('mobileOverlay');

        function openSidebar() {
            if (sidebar) sidebar.classList.remove('translate-x-full');
            if (mobileOverlay) mobileOverlay.classList.remove('hidden');
        }

        function closeSidebar() {
            if (sidebar) sidebar.classList.add('translate-x-full');
            if (mobileOverlay) mobileOverlay.classList.add('hidden');
        }

        if (mobileMenuBtn) mobileMenuBtn.addEventListener('click', openSidebar);
        if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', closeSidebar);
        if (mobileOverlay) mobileOverlay.addEventListener('click', closeSidebar);

        // Global Live Search Handler
        const globalSearchInput = document.getElementById('globalLiveSearch');
        const globalSearchResults = document.getElementById('globalSearchResults');
        const clearGlobalSearchBtn = document.getElementById('clearGlobalSearchBtn');
        let searchDebounceTimer = null;

        if (globalSearchInput) {
            globalSearchInput.addEventListener('input', function() {
                const query = this.value.trim();
                if (clearGlobalSearchBtn) {
                    clearGlobalSearchBtn.classList.toggle('hidden', !query);
                }
                clearTimeout(searchDebounceTimer);
                if (query.length < 2) {
                    globalSearchResults.classList.add('hidden');
                    globalSearchResults.innerHTML = '';
                    return;
                }
                searchDebounceTimer = setTimeout(async () => {
                    try {
                        const res = await fetch(`/api/search?q=${encodeURIComponent(query)}`);
                        const data = await res.json();
                        const results = data.results || [];
                        if (results.length === 0) {
                            globalSearchResults.innerHTML = `
                                <div class="p-4 text-center text-slate-400 text-xs">
                                    لا توجد نتائج مطابقة لـ "${query}"
                                </div>
                            `;
                        } else {
                            globalSearchResults.innerHTML = results.map(r => `
                                <a href="${r.url}" class="flex items-center gap-3 p-3 hover:bg-slate-50 transition border-b border-slate-100 last:border-0">
                                    <span class="text-base w-7 text-center">${r.icon || '🔍'}</span>
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center justify-between">
                                            <div class="text-xs font-bold text-slate-800 truncate">${r.title}</div>
                                            <span class="text-[10px] bg-slate-100 text-slate-600 px-2 py-0.5 rounded font-bold">${r.type}</span>
                                        </div>
                                        ${r.subtitle ? `<div class="text-[11px] text-slate-400 truncate">${r.subtitle}</div>` : ''}
                                    </div>
                                </a>
                            `).join('');
                        }
                        globalSearchResults.classList.remove('hidden');
                    } catch (e) {
                        console.error('Search error', e);
                    }
                }, 250);
            });

            if (clearGlobalSearchBtn) {
                clearGlobalSearchBtn.addEventListener('click', function() {
                    globalSearchInput.value = '';
                    globalSearchResults.classList.add('hidden');
                    clearGlobalSearchBtn.classList.add('hidden');
                    globalSearchInput.focus();
                });
            }

            document.addEventListener('click', function(e) {
                if (!globalSearchInput.contains(e.target) && !globalSearchResults.contains(e.target)) {
                    globalSearchResults.classList.add('hidden');
                }
            });
        }

        // =======================================================================
        //          REAL-TIME LIVE MULTI-DEVICE SYNC ENGINE ⚡
        // =======================================================================
        (function() {
            let lastFingerprint = null;
            let isPolling = false;

            // Top Live Sync Toast Element
            const liveToast = document.createElement('div');
            liveToast.id = 'stargateLiveSyncToast';
            liveToast.className = 'fixed top-4 left-1/2 -translate-x-1/2 z-50 bg-slate-900/90 text-white backdrop-blur-md px-5 py-2.5 rounded-2xl shadow-2xl border border-emerald-500/40 text-xs font-black flex items-center gap-2.5 transition-all duration-300 opacity-0 pointer-events-none translate-y-[-20px]';
            liveToast.innerHTML = '<span class="relative flex h-2.5 w-2.5"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span></span><span id="stargateLiveSyncText">مزامنة حية فورية: تم تحديث البيانات!</span>';
            document.body.appendChild(liveToast);

            function showLiveToast(msg, duration = 3500) {
                const textEl = document.getElementById('stargateLiveSyncText');
                if (textEl) textEl.textContent = msg;
                liveToast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-[-20px]');
                liveToast.classList.add('opacity-100', 'translate-y-0');
                setTimeout(() => {
                    liveToast.classList.remove('opacity-100', 'translate-y-0');
                    liveToast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-[-20px]');
                }, duration);
            }

            let pendingRefresh = false;

            function isUserActivelyWritingModal() {
                // Check if any modal is open and has user-entered content
                const visibleModals = Array.from(document.querySelectorAll('div[id$="Modal"]')).filter(m => {
                    return !m.classList.contains('hidden') && m.offsetParent !== null;
                });
                if (visibleModals.length === 0) return false;

                for (const modal of visibleModals) {
                    const inputs = modal.querySelectorAll('input:not([type="hidden"]):not([type="submit"]):not([type="radio"]):not([type="checkbox"]), textarea');
                    for (const inp of inputs) {
                        if (inp.value && inp.value.trim().length > 0) {
                            return true;
                        }
                    }
                }
                return false;
            }

            function pollLiveSync() {
                if (isPolling || document.hidden) return;
                isPolling = true;

                fetch('/api/live/pulse', {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(res => {
                    if (!res.ok) return null;
                    return res.json();
                })
                .then(data => {
                    isPolling = false;
                    if (!data || !data.success) return;

                    if (lastFingerprint === null) {
                        lastFingerprint = data.fingerprint;
                        return;
                    }

                    if (data.fingerprint !== lastFingerprint) {
                        if (isUserActivelyWritingModal()) {
                            pendingRefresh = true;
                            showLiveToast('🔔 تم تسجيل بيانات جديدة! سيتم التحديث فور إغلاق النافذة...');
                        } else {
                            lastFingerprint = data.fingerprint;
                            pendingRefresh = false;
                            showLiveToast('🟢 تحديث فوري مباشر: تم تسجيل بيانات جديدة في السيستم!');
                            setTimeout(() => {
                                window.location.reload();
                            }, 500);
                        }
                    }
                })
                .catch(() => {
                    isPolling = false;
                });
            }

            // Check every 2.5 seconds for instant real-time synchronization
            setInterval(pollLiveSync, 2500);

            // Also check immediately when tab/device wakes up
            document.addEventListener('visibilitychange', () => {
                if (!document.hidden) {
                    pollLiveSync();
                }
            });

            // If a refresh was pending while writing, reload immediately when modal is closed
            window.addEventListener('click', (e) => {
                if (pendingRefresh && !isUserActivelyWritingModal()) {
                    pendingRefresh = false;
                    window.location.reload();
                }
            });
        })();
    </script>
    
<script>
    // Weekly Delivered Chart
    const ctx = document.getElementById('weeklyChart').getContext('2d');
    const chartDays = ["09/02", "09/03", "09/04", "09/05", "09/06", "09/07", "09/08"];
    const chartDelivered = [0, 0, 0, 0, 0, 0, 0];
    const chartRevenue = [0, 0, 0, 0, 0, 0, 0];

    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: chartDays,
            datasets: [
                {
                    label: 'عدد الطلبات المسلمة',
                    data: chartDelivered,
                    backgroundColor: 'rgba(37, 99, 235, 0.85)',
                    borderRadius: 8,
                    yAxisID: 'y'
                },
                {
                    label: 'إيراد التوصيل (ل.ل)',
                    data: chartRevenue,
                    type: 'line',
                    borderColor: 'rgba(16, 185, 129, 1)',
                    backgroundColor: 'rgba(16, 185, 129, 0.1)',
                    fill: true,
                    tension: 0.3,
                    yAxisID: 'y1'
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: {
                mode: 'index',
                intersect: false,
            },
            scales: {
                x: {
                    grid: { display: false }
                },
                y: {
                    type: 'linear',
                    display: true,
                    position: 'right',
                    title: { display: true, text: 'عدد الطلبات' },
                    grid: { color: '#f1f5f9' }
                },
                y1: {
                    type: 'linear',
                    display: true,
                    position: 'left',
                    grid: { drawOnChartArea: false },
                    title: { display: true, text: 'الإيراد' }
                }
            }
        }
    });

    // Executive Report Modal Controller
    async function openExecutiveReportModal() {
        const modal = document.getElementById('executiveReportModal');
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';

        try {
            const res = await fetch('/api/ai/executive-report');
            const data = await res.json();
            
            if (data) {
                // Update KPIs
                if (data.health_score) {
                    document.getElementById('modalHealthScoreBadge').innerText = `كفاءة النظام ${data.health_score}%`;
                }
                if (data.kpis) {
                    document.getElementById('kpiTotalOrders').innerText = data.kpis.total_orders || 0;
                    document.getElementById('kpiSuccessRate').innerText = `${data.kpis.success_rate || 0}%`;
                    document.getElementById('kpiReturnRate').innerText = `${data.kpis.return_rate || 0}%`;
                    document.getElementById('kpiProfitMargin').innerText = `${data.kpis.profit_margin_percent || 0}%`;
                }

                // Render Couriers Table
                const couriersBody = document.getElementById('couriersTableBody');
                if (data.couriers_ranking && data.couriers_ranking.length > 0) {
                    couriersBody.innerHTML = data.couriers_ranking.map((c, i) => `
                        <tr class="hover:bg-slate-50 transition">
                            <td class="py-2.5 px-2 font-bold">${c.badge || ('#' + (i+1))}</td>
                            <td class="py-2.5 px-2 font-black text-slate-800">
                                <div>${c.name}</div>
                                <span class="text-[10px] text-slate-400">${c.phone || ''}</span>
                            </td>
                            <td class="py-2.5 px-2 text-center font-bold text-emerald-600">${c.delivered_count}</td>
                            <td class="py-2.5 px-2 text-center font-mono font-bold">${c.success_rate}%</td>
                            <td class="py-2.5 px-2 text-left font-mono font-bold text-amber-600">${(c.total_commission || 0).toLocaleString()}</td>
                        </tr>
                    `).join('');
                } else {
                    couriersBody.innerHTML = `<tr><td colspan="5" class="py-4 text-center text-slate-400">لا توجد إحصائيات كافية للسائقين بعد</td></tr>`;
                }

                // Render Agents Table
                const agentsBody = document.getElementById('agentsTableBody');
                if (data.agents_ranking && data.agents_ranking.length > 0) {
                    agentsBody.innerHTML = data.agents_ranking.map((a, i) => `
                        <tr class="hover:bg-slate-50 transition">
                            <td class="py-2.5 px-2 font-bold">${a.badge || ('#' + (i+1))}</td>
                            <td class="py-2.5 px-2 font-black text-slate-800">${a.agent_name}</td>
                            <td class="py-2.5 px-2 text-center font-mono font-bold text-blue-600">${a.total_orders}</td>
                            <td class="py-2.5 px-2 text-center font-mono font-bold text-emerald-600">${a.delivered_orders}</td>
                            <td class="py-2.5 px-2 text-center font-mono font-bold">${a.success_rate}%</td>
                        </tr>
                    `).join('');
                } else {
                    agentsBody.innerHTML = `<tr><td colspan="5" class="py-4 text-center text-slate-400">لا توجد إحصائيات لموظفي الإدخال بعد</td></tr>`;
                }

                // Render Top Merchants
                const merchantsList = document.getElementById('topMerchantsList');
                if (data.top_merchants && data.top_merchants.length > 0) {
                    merchantsList.innerHTML = data.top_merchants.map((m, i) => `
                        <div class="flex items-center justify-between p-2.5 rounded-xl bg-slate-50 border border-slate-100">
                            <div class="flex items-center gap-2">
                                <span class="w-6 h-6 rounded-lg bg-indigo-100 text-indigo-700 text-xs font-black flex items-center justify-center">${i+1}</span>
                                <span class="font-bold text-slate-800">${m.store_name || m.name}</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="text-xs text-slate-500 font-semibold">${m.order_count} طلب</span>
                                <span class="text-xs font-black text-indigo-600 font-mono">${(m.total_volume || 0).toLocaleString()} ل.ل</span>
                            </div>
                        </div>
                    `).join('');
                } else {
                    merchantsList.innerHTML = `<div class="py-4 text-center text-xs text-slate-400">لا توجد بيانات متاجر كافية</div>`;
                }

                // Render AI Recommendations
                const recList = document.getElementById('aiRecommendationsList');
                if (data.recommendations && data.recommendations.length > 0) {
                    recList.innerHTML = data.recommendations.map(r => `
                        <div class="p-2.5 rounded-xl bg-white/10 border border-white/10 flex items-start gap-2.5 leading-relaxed">
                            <i class="fa-solid fa-lightbulb text-amber-300 mt-0.5 shrink-0 text-sm"></i>
                            <span>${r}</span>
                        </div>
                    `).join('');
                } else {
                    recList.innerHTML = `<div class="p-3 rounded-xl bg-white/10 text-center">العمليات تسير بكفاءة ممتازة ومثالية 🚀</div>`;
                }
            }
        } catch (e) {
            console.error('Failed to load executive report:', e);
        }
    }

    function closeExecutiveReportModal() {
        const modal = document.getElementById('executiveReportModal');
        modal.classList.add('hidden');
        document.body.style.overflow = '';
    }

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeExecutiveReportModal();
    });

    // Real-Time Auto-Check Heartbeat (every 25 seconds without page reload interruption)
    setInterval(async () => {
        try {
            const res = await fetch('/api/ai/risk-radar');
            const data = await res.json();
            const risks = data.risks || data.flags || [];
            // If new high severity risks appear, smoothly reload to display pulsating alert
            const hasHigh = risks.some(r => r.severity === 'high');
            const currentHasHigh = document.querySelector('.animate-pulse') !== null;
            if (hasHigh !== currentHasHigh) {
                window.location.reload();
            }
        } catch (e) {
            // silent catch
        }
    }, 25000);
</script>

</body>
</html>