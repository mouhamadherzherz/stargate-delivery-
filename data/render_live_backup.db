<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="theme-color" content="#1E1B54">
    <meta name="application-name" content="stargate experts">
    <title>Stargate Delivery - نظام محاسبة وإدارة الدلفري</title>
    <!-- Local Offline Tailwind CSS Engine -->
    <script src="/static/js/tailwindcss.js"></script>
    <script>
        tailwind.config = {
            theme: {
                screens: {
                    'xs': '480px',
                    'sm': '640px',
                    'md': '768px',
                    'lg': '1024px',
                    'xl': '1280px',
                    '2xl': '1536px',
                },
                extend: {
                    colors: {
                        stargate: {
                            navy: '#1E1B54',
                            cyan: '#00B5FF',
                            orange: '#FF7A00',
                            green: '#00D26A',
                            dark: '#0F172A'
                        },
                        brand: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            500: '#00B5FF',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#1E1B54',
                            900: '#0F172A',
                        }
                    },
                    fontFamily: {
                        sans: ['Cairo', 'Segoe UI', 'Tahoma', 'Arial', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- Local Offline Font Awesome Icons -->
    <link rel="stylesheet" href="/static/css/font-awesome.min.css">
    <!-- Local Offline Chart.js -->
    <script src="/static/js/chart.min.js"></script>
    <!-- Local Offline JsBarcode -->
    <script src="/static/js/JsBarcode.all.min.js"></script>

    <style>
        body {
            font-family: 'Cairo', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }
        @media print {
            .no-print {
                display: none !important;
            }
            .print-only {
                display: block !important;
            }
            body {
                background: white !important;
                color: black !important;
            }
        }
        /* Mobile Touch & Table responsiveness */
        @media (max-width: 768px) {
            .table-responsive-wrapper {
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }
            input, select, textarea, button {
                font-size: 16px !important; /* Prevents auto-zoom on iOS */
            }
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 antialiased min-h-screen flex flex-col">

    <!-- Mobile Overlay Backlayer -->
    <div id="mobileOverlay" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-40 hidden lg:hidden transition-opacity"></div>

    <!-- Mobile Navigation Bar -->
    <header class="bg-[#1E1B54] text-white shadow-lg lg:hidden flex items-center justify-between p-3.5 sticky top-0 z-50 border-b border-white/10">
        <div class="flex items-center space-x-3 space-x-reverse">
            <button id="mobileMenuBtn" class="p-2 rounded-xl bg-white/10 hover:bg-white/20 text-white focus:outline-none flex items-center justify-center">
                <i class="fa-solid fa-bars text-lg text-[#00B5FF]"></i>
            </button>
            <div class="flex items-center gap-2">
                <span class="text-lg">🇱🇧</span>
                <span class="font-black text-base tracking-wide text-white">Stargate Delivery</span>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <a href="/auth/logout" onclick="return confirm('هل تريد تسكير النظام وتسجيل الخروج؟');" class="bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs px-3 py-1.5 rounded-xl flex items-center gap-1.5 shadow-xs transition">
                <i class="fa-solid fa-power-off text-xs"></i>
                <span>خروج 🔒</span>
            </a>
        </div>
    </header>

    <!-- Mobile Sticky Bottom Navigation Bar for ultra-fast thumb navigation -->
    <div class="lg:hidden fixed bottom-0 left-0 right-0 bg-[#1E1B54]/95 backdrop-blur-lg border-t border-white/10 z-50 px-2 py-1.5 flex items-center justify-around text-slate-300">
        <a href="/" class="flex flex-col items-center justify-center py-1 px-3 rounded-xl text-[#00B5FF] font-black">
            <i class="fa-solid fa-chart-pie text-lg"></i>
            <span class="text-[10px] mt-0.5">الرئيسية</span>
        </a>
        <a href="/orders" class="flex flex-col items-center justify-center py-1 px-3 rounded-xl text-slate-300">
            <i class="fa-solid fa-box-open text-lg"></i>
            <span class="text-[10px] mt-0.5">الطلبات</span>
        </a>
        <a href="/ai/assistant" class="flex flex-col items-center justify-center py-1 px-2 rounded-xl text-amber-400">
            <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-[#00B5FF] to-[#FF7A00] flex items-center justify-center text-white shadow-md shadow-cyan-500/20 -mt-4 border-2 border-[#1E1B54]">
                <i class="fa-solid fa-wand-magic-sparkles text-sm"></i>
            </div>
            <span class="text-[10px] mt-0.5 font-bold">الذكاء</span>
        </a>
        <a href="/couriers" class="flex flex-col items-center justify-center py-1 px-3 rounded-xl text-slate-300">
            <i class="fa-solid fa-motorcycle text-lg"></i>
            <span class="text-[10px] mt-0.5">السائقين</span>
        </a>
        <a href="/merchants" class="flex flex-col items-center justify-center py-1 px-3 rounded-xl text-slate-300">
            <i class="fa-solid fa-store text-lg"></i>
            <span class="text-[10px] mt-0.5">التجار</span>
        </a>
    </div>

    <div class="flex flex-1 relative overflow-hidden">
        <!-- Sidebar Navigation -->
        <aside id="sidebar" class="w-64 bg-[#1E1B54] text-slate-200 flex flex-col shrink-0 fixed inset-y-0 right-0 z-40 transform translate-x-full lg:translate-x-0 lg:static transition-transform duration-200 ease-in-out border-l border-white/10 shadow-2xl">
            <!-- Sidebar Header -->
            <div class="p-5 border-b border-white/10 flex items-center justify-between bg-gradient-to-r from-[#1E1B54] to-[#151240]">
                <div class="flex items-center gap-3">
                    <div class="p-1.5 bg-white rounded-2xl shadow-lg border border-cyan-500/30 flex items-center justify-center shrink-0">
                        <img src="/static/images/logo.png" alt="Stargate Logo" class="h-10 w-auto object-contain">
                    </div>
                    <div>
                        <h1 class="font-black text-white text-base tracking-wide leading-tight">STARGATE</h1>
                        <span class="text-[11px] text-[#00B5FF] font-black block tracking-wider uppercase">EXPERTS</span>
                    </div>
                </div>
                <button id="closeSidebarBtn" class="lg:hidden text-slate-400 hover:text-white p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <!-- Navigation Links (Lebanese dialect with Role Protection) -->
            <nav class="flex-1 p-3 space-y-1.5 overflow-y-auto">
                <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-xl font-semibold transition bg-gradient-to-r from-[#00B5FF] to-[#0092D0] text-white shadow-lg shadow-[#00B5FF]/25 font-bold">
                    <i class="fa-solid fa-chart-pie text-lg w-6 text-center text-[#FF7A00]"></i>
                    <span>لوحة المتابعة العامة</span>
                </a>

                <a href="/ai/assistant" class="flex items-center gap-3 px-4 py-3 rounded-xl font-semibold transition text-cyan-300 hover:bg-white/10 hover:text-white">
                    <i class="fa-solid fa-wand-magic-sparkles text-lg w-6 text-center text-amber-300"></i>
                    <span class="flex-1">المساعد الذكي (AI)</span>
                    <span class="text-[10px] bg-amber-500 text-slate-950 px-2 py-0.5 rounded-full font-black">جديد</span>
                </a>

                <a href="/orders" class="flex items-center gap-3 px-4 py-3 rounded-xl font-semibold transition text-slate-200 hover:bg-white/10 hover:text-white">
                    <i class="fa-solid fa-box-open text-lg w-6 text-center text-[#00D26A]"></i>
                    <span>الأوردرات والطلبيات</span>
                </a>

                <a href="/customers" class="flex items-center gap-3 px-4 py-3 rounded-xl font-semibold transition text-slate-200 hover:bg-white/10 hover:text-white">
                    <i class="fa-solid fa-address-book text-lg w-6 text-center text-[#00B5FF]"></i>
                    <span>دليل الزبائن والعناوين</span>
                </a>

                <a href="/couriers" class="flex items-center gap-3 px-4 py-3 rounded-xl font-semibold transition text-slate-200 hover:bg-white/10 hover:text-white">
                    <i class="fa-solid fa-motorcycle text-lg w-6 text-center text-[#FF7A00]"></i>
                    <span>شباب الدليفري والكاش</span>
                </a>

                <a href="/merchants" class="flex items-center gap-3 px-4 py-3 rounded-xl font-semibold transition text-slate-200 hover:bg-white/10 hover:text-white">
                    <i class="fa-solid fa-store text-lg w-6 text-center text-[#00D26A]"></i>
                    <span>المحلات والتجار (البيجات)</span>
                </a>

                
                <div class="pt-3 pb-1 px-4">
                    <span class="text-[11px] uppercase tracking-wider text-amber-400 font-black">إدارة النظام 👑</span>
                </div>

                <a href="/admin/login" class="flex items-center gap-3 px-4 py-3 rounded-xl font-bold transition text-amber-300 hover:bg-white/10 hover:text-white">
                    <i class="fa-solid fa-crown text-lg w-6 text-center text-amber-400"></i>
                    <span>لوحة تحكم المدير العام</span>
                </a>

                <a href="/employees" class="flex items-center gap-3 px-4 py-3 rounded-xl font-semibold transition text-slate-200 hover:bg-white/10 hover:text-white">
                    <i class="fa-solid fa-users-gear text-lg w-6 text-center text-cyan-300"></i>
                    <span>إدارة الموظفين والحسابات</span>
                </a>

                <a href="/settings" class="flex items-center gap-3 px-4 py-3 rounded-xl font-semibold transition text-slate-200 hover:bg-white/10 hover:text-white">
                    <i class="fa-solid fa-gears text-lg w-6 text-center text-slate-300"></i>
                    <span>الإعدادات</span>
                </a>
                

                
                <div class="pt-3 pb-1 px-4">
                    <span class="text-[11px] uppercase tracking-wider text-[#00B5FF] font-black">المالية والتقارير 📊</span>
                </div>
                

                
                <a href="/settlements" class="flex items-center gap-3 px-4 py-3 rounded-xl font-semibold transition text-slate-200 hover:bg-white/10 hover:text-white">
                    <i class="fa-solid fa-file-invoice-dollar text-lg w-6 text-center text-[#00D26A]"></i>
                    <span>سندات التسكير والدفع</span>
                </a>
                

                
                <a href="/treasury" class="flex items-center gap-3 px-4 py-3 rounded-xl font-semibold transition text-slate-200 hover:bg-white/10 hover:text-white">
                    <i class="fa-solid fa-vault text-lg w-6 text-center text-amber-400"></i>
                    <span>الصندوق والمصاريف</span>
                </a>
                

                
                <a href="/reports" class="flex items-center gap-3 px-4 py-3 rounded-xl font-semibold transition text-slate-200 hover:bg-white/10 hover:text-white">
                    <i class="fa-solid fa-chart-line text-lg w-6 text-center"></i>
                    <span>تقارير الأرباح والمحاسبة</span>
                </a>
                

                
            </nav>

            <!-- Sidebar Footer -->
            <div class="p-4 border-t border-slate-800 text-xs text-slate-400 bg-slate-950/50 space-y-2.5">
                <a href="/auth/logout" onclick="return confirm('هل تريد تسكير النظام وتسجيل الخروج لتسليم الوردية للموظف؟');" class="w-full bg-rose-600 hover:bg-rose-700 text-white font-black text-xs py-2.5 px-3 rounded-xl flex items-center justify-center gap-2 transition shadow-md shadow-rose-600/30">
                    <i class="fa-solid fa-power-off text-sm"></i>
                    <span>تسكير النظام وتسليم الموظف 🔒</span>
                </a>
                <div class="flex items-center justify-between pt-1">
                    <span>السيستم:</span>
                    <span class="inline-flex items-center gap-1.5 text-emerald-400 font-bold">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> شغّال محلياً 🇱🇧
                    </span>
                </div>
                <div class="text-slate-500">سعر الصرف: 1$ = 89,500 ل.ل</div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="flex-1 flex flex-col min-w-0 overflow-y-auto bg-slate-50">
            <!-- Top Header Desktop -->
            <header class="bg-white/95 backdrop-blur-md border-b border-slate-200/80 hidden lg:flex items-center justify-between px-6 py-3 shadow-xs gap-4 sticky top-0 z-30">
                <div class="flex items-center gap-2.5 shrink-0 flex-wrap">
                    <span class="text-xs bg-[#00D26A]/10 text-[#008f47] px-3.5 py-1.5 rounded-full font-bold border border-[#00D26A]/30 flex items-center gap-1.5 shadow-xs" title="سعر الصرف المعتمد">
                        <i class="fa-solid fa-money-bill-transfer text-[#00D26A]"></i> 1$ = 89,500 ل.ل
                    </span>

                    
                    <!-- Quick Street Cash Badge -->
                    <a href="/couriers" class="text-xs bg-[#FF7A00]/10 hover:bg-[#FF7A00]/20 text-[#D46500] px-3.5 py-1.5 rounded-full font-black border border-[#FF7A00]/30 flex items-center gap-1.5 shadow-xs transition" title="كاش مقبوض بالشارع مع السائقين">
                        <i class="fa-solid fa-motorcycle text-[#FF7A00]"></i>
                        <span>كاش الشارع:</span>
                        <span class="font-mono text-[#FF7A00] font-black">$0.00</span>
                    </a>

                    <!-- Quick Whish Badge -->
                    <a href="/treasury" class="text-xs bg-[#00B5FF]/10 hover:bg-[#00B5FF]/20 text-[#0080B8] px-3.5 py-1.5 rounded-full font-black border border-[#00B5FF]/30 flex items-center gap-1.5 shadow-xs transition" title="رصيد بطاقة Whish الإلكترونية المنفصلة">
                        <i class="fa-solid fa-credit-card text-[#00B5FF]"></i>
                        <span>ويش:</span>
                        <span class="font-mono text-[#00B5FF] font-black">$0.00</span>
                    </a>

                    <!-- Active Role Badge & Switcher -->
                    <span class="text-xs bg-[#1E1B54] text-white px-3.5 py-1.5 rounded-full font-black border border-[#1E1B54]/40 flex items-center gap-1.5 shadow-xs">
                        <span>👑 المدير العام</span>
                    </span>
                    <a href="/auth/logout" onclick="return confirm('هل تريد تسكير النظام وتسجيل الخروج لتسليمه للموظف؟');" class="text-xs bg-rose-50 hover:bg-rose-100 text-rose-800 font-bold px-3.5 py-1.5 rounded-xl transition flex items-center gap-1.5 border border-rose-300 shadow-xs cursor-pointer" title="تسكير وقفل النظام بالكامل لتسليمه للموظف">
                        <i class="fa-solid fa-power-off text-rose-600"></i>
                        <span>تسجيل خروج / تسكير 🔒</span>
                    </a>
                    
                </div>

                <!-- Global Live Search Bar -->
                <div class="relative flex-1 max-w-md mx-2">
                    <div class="relative">
                        <i class="fa-solid fa-magnifying-glass absolute right-3.5 top-3 text-slate-400 text-xs"></i>
                        <input type="text" id="globalLiveSearch" placeholder="بحث شامل سريع (أوردر، زبون، هاتف، متجر، سائق)..." 
                               autocomplete="off"
                               class="w-full bg-slate-50 hover:bg-slate-100 focus:bg-white border border-slate-200 rounded-xl pr-9 pl-8 py-2 text-xs font-medium focus:ring-2 focus:ring-[#00B5FF] transition shadow-xs">
                        <button id="clearGlobalSearchBtn" class="hidden absolute left-3 top-2.5 text-slate-400 hover:text-slate-600 text-xs">
                            <i class="fa-solid fa-circle-xmark"></i>
                        </button>
                    </div>

                    <!-- Dropdown Results -->
                    <div id="globalSearchResults" class="hidden absolute top-full mt-1.5 right-0 left-0 bg-white border border-slate-200 rounded-2xl shadow-xl z-50 overflow-hidden max-h-80 overflow-y-auto">
                    </div>
                </div>

                <!-- User Profile & Action Controls -->
                <div class="flex items-center gap-2 shrink-0">
                    <button type="button" onclick="triggerTelegramDailyReport(this)" class="inline-flex items-center gap-1.5 bg-[#00B5FF]/10 hover:bg-[#00B5FF]/20 text-[#0080B8] border border-[#00B5FF]/30 text-xs font-black px-3 py-2 rounded-xl transition shadow-xs cursor-pointer" title="إرسال التقرير المالي والتشغيلي الشامل للمدير عبر التيليجرام">
                        <i class="fa-brands fa-telegram text-[#00B5FF] text-sm"></i>
                        <span class="hidden sm:inline">تقرير للمدير 📲</span>
                    </button>

                    <a href="/orders?open_new=1" class="inline-flex items-center gap-1.5 bg-gradient-to-r from-[#FF7A00] to-[#E06C00] hover:from-[#E06C00] text-white text-xs font-black px-3.5 py-2 rounded-xl shadow-md shadow-[#FF7A00]/25 transition">
                        <i class="fa-solid fa-plus"></i>
                        <span>أوردر جديد</span>
                    </a>

                    
                    <div class="flex items-center gap-2 pr-2 border-r border-slate-200">
                    <div class="w-8 h-8 rounded-xl bg-slate-100 text-slate-700 border border-slate-200 flex items-center justify-center text-xs font-black">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <div class="text-right hidden xl:block">
                            <div class="text-xs font-bold text-slate-800 leading-tight">المدير العام</div>
                            <div class="text-[10px] text-slate-400">مدير عام</div>
                        </div>
                        <a href="/auth/logout" onclick="return confirm('هل أنت متأكد من تسكير النظام وتسجيل الخروج؟');" class="inline-flex items-center gap-1.5 bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold px-3 py-2 rounded-xl transition shadow-xs shadow-rose-600/20 cursor-pointer" title="تسكير النظام وتسجيل الخروج">
                            <i class="fa-solid fa-power-off text-xs"></i>
                            <span class="hidden sm:inline">تسكير النظام 🔒</span>
                        </a>
                    </div>
                    
                </div>
            </header>

            <!-- Flash Messages Notification Container -->
            <div class="px-6 lg:px-8 pt-4">
                
                    
                
            </div>

    <!-- Page Content Body -->
            <div class="p-6 lg:p-8 flex-1">
                
<div class="space-y-6">

    <!-- REAL-TIME FINANCIAL RISK RADAR ALERT BANNER -->
    

    <!-- Top Page Title & Quick Actions Banner -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
        <div>
            <h2 class="text-2xl font-black text-slate-800 flex items-center gap-2">
                <span>Stargate Delivery - متابعة العمليات</span>
                <span class="text-2xl">🇱🇧</span>
            </h2>
            <p class="text-sm text-slate-500 mt-1">
                
                لوحة المتابعة الإدارية والمالية: الصندوق، كاش الشارع، مستحقات المحلات، والأرباح.
                
            </p>
        </div>
        <div class="flex items-center gap-2 flex-wrap">
            <button type="button" onclick="triggerTelegramDailyReport(this)" class="inline-flex items-center gap-2 bg-[#00B5FF] hover:bg-[#0092D0] text-white text-sm font-black px-4 py-2.5 rounded-xl shadow-md shadow-[#00B5FF]/20 transition cursor-pointer" title="إرسال تقرير تنفيذي شامل ومفصل لحساب تيليجرام المدير">
                <i class="fa-brands fa-telegram text-base"></i>
                <span>إرسال تقرير للمدير 📲</span>
            </button>
            <a href="/orders?open_new=1" class="inline-flex items-center gap-2 bg-gradient-to-r from-[#FF7A00] to-[#E06C00] hover:from-[#E06C00] hover:to-[#C55F00] text-white text-sm font-black px-4 py-2.5 rounded-xl shadow-md shadow-[#FF7A00]/25 transition">
                <i class="fa-solid fa-plus"></i>
                <span>تسجيل أوردر جديد 📦</span>
            </a>
            
            <a href="/couriers" class="inline-flex items-center gap-2 bg-[#1E1B54] hover:bg-[#151240] text-white text-sm font-bold px-4 py-2.5 rounded-xl transition">
                <i class="fa-solid fa-motorcycle text-[#FF7A00]"></i>
                <span>تسكير حساب دليفري</span>
            </a>
            <a href="/merchants" class="inline-flex items-center gap-2 bg-[#00D26A] hover:bg-[#00B359] text-white text-sm font-bold px-4 py-2.5 rounded-xl shadow-md shadow-[#00D26A]/20 transition">
                <i class="fa-solid fa-hand-holding-dollar"></i>
                <span>دفع مصاري المحلات</span>
            </a>
            
        </div>
    </div>

    
    <!-- 5 Main Financial KPI Cards (Admin Only) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <!-- 1. Treasury Cash -->
        <div class="bg-gradient-to-br from-emerald-600 to-teal-700 text-white p-5 rounded-2xl shadow-lg shadow-emerald-600/10 relative overflow-hidden">
            <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-emerald-100">كاش الصندوق (الخزينة)</span>
                <div class="w-9 h-9 rounded-xl bg-white/10 backdrop-blur-md flex items-center justify-center text-white">
                    <i class="fa-solid fa-vault text-base"></i>
                </div>
            </div>
            <div class="mt-3">
                <div class="text-xl font-black tracking-tight font-mono">0 <span class="text-xs font-sans font-normal">ل.ل</span></div>
                <div class="text-xs text-emerald-200 font-bold font-mono mt-0.5">≈ $0.00</div>
                <span class="text-[11px] text-emerald-100/80 mt-1 block font-medium">السيولة النقدية بالصندوق</span>
            </div>
            <div class="mt-3 pt-2.5 border-t border-white/10 flex items-center justify-between text-xs text-emerald-100">
                <a href="/treasury" class="hover:underline flex items-center gap-1 font-bold text-[11px]">
                    <span>حركات الصندوق</span>
